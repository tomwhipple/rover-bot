# roverd on the rover's Pi: installed as /etc/systemd/system/roverd.service by `make deploy`.
# Stop it before flashing the aLaMode: both use the serial port.
[Unit]
Description=roverd, the rover's bus adapter
After=network-online.target
Wants=network-online.target

[Service]
User=tw
# ROVER_DESCRIPTION_COMMIT, the rover repo commit `make deploy` installed, goes out in Info.
EnvironmentFile=-/usr/local/share/rover/deployed.env
# %H is this host's name: the console reaches the stream by mDNS. The port is stream_port in rover.conf.
# --home is robo/robot.json's "home".
ExecStart=/usr/local/bin/roverd --serial /dev/serial0 --robot-id rover --home pan=0 --description-commit ${ROVER_DESCRIPTION_COMMIT} --camera mast=http://%H.local:8080/mast.mjpg
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
