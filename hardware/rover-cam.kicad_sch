	(text "Notes\nVBAT = pack after fuse and switch, 10.5-12.6 V.\nAll grounds are common: run EXT_PWR GND and buck IN- straight\nto the pack negative in heavy wire.\nServo 1 header power is the shield's 5 V logic rail, not EXT_PWR.\n5 A fuse because two stalled motors can exceed 3 A."
		(exclude_from_sim no)
		(at 292.1 190.5 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "2ed2e455-6e34-4320-848b-9875540edb88")
	)
	(text "Pi powered via USB-C (see J2).\nPi Camera v1 on the CSI ribbon."
		(exclude_from_sim no)
		(at 162.56 153.67 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "94863b92-2aec-41fd-87c9-c42e847d312c")
	)
	(text "Cut USB-A→C cable into the Pi's USB-C;\nred = +5 V, black = GND. Meter it before\nplugging in.\nU1: AKEYSRC 5 V 3 A buck (B0GYJDP96Q)."
		(exclude_from_sim no)
		(at 91.44 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9594ba1f-fbc7-416a-972a-835a7a915a8e")
	)
	(text "VBAT: pack after fuse and switch, 10.5-12.6 V.\n5 A fuse: two stalled motors can exceed 3 A."
		(exclude_from_sim no)
		(at 30.48 37 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "a0becac1-efe6-4425-b9b4-a015d739afd9")
	)
	(text "Pack voltage divider to A0."
		(exclude_from_sim no)
		(at 166.37 172.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "bc5e9a43-9bf4-46cc-9b7b-625fcb3c4443")
	)
	(text "5V-LINK jumper ON: powered from the Pi.\nRESET is capacitor-coupled to GPIO18\non the aLaMode.\nPi-aLaMode and aLaMode-shield links\nare stacked headers, not wires."
		(exclude_from_sim no)
		(at 248.92 148.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ea83e80f-edf1-498b-9b28-cfd2d43f28ef")
	)
	(text "HC-SR04 VCC comes from the A3-A5 header 5 V row\n(the A0-A2 row is 3.3 V)."
		(exclude_from_sim no)
		(at 236.22 200.66 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ebc2812e-8770-4eda-8e06-5496f47bb1ae")
	)
