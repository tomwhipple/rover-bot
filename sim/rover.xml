<mujoco model="rover">
  <!-- Nominal geometry, none of it measured: wheel radius 0.033, track 0.18,
       body radius 0.10, mast top 0.28 m, sensor 0.10 m ahead of the centre. -->
  <compiler angle="degree"/>
  <option timestep="0.001" gravity="0 0 -9.81"/>
  <visual>
    <global offwidth="640" offheight="480"/>
    <quality shadowsize="2048"/>
    <headlight ambient="0.45 0.45 0.45" diffuse="0.5 0.5 0.5" specular="0 0 0"/>
    <map znear="0.01" zfar="20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.75 0.85 0.95" rgb2="0.35 0.4 0.5" width="256" height="256"/>
    <texture name="checker" type="2d" builtin="checker" rgb1="0.82 0.82 0.80" rgb2="0.35 0.35 0.38" width="256" height="256" mark="edge" markrgb="0.2 0.2 0.2"/>
    <material name="floor" texture="checker" texrepeat="10 10" reflectance="0.05"/>
    <material name="wall_n" rgba="0.85 0.25 0.25 1"/>
    <material name="wall_s" rgba="0.25 0.45 0.85 1"/>
    <material name="wall_e" rgba="0.95 0.85 0.25 1"/>
    <material name="wall_w" rgba="0.30 0.75 0.40 1"/>
    <material name="crate" rgba="0.65 0.45 0.25 1"/>
    <material name="biped" rgba="0.95 0.5 0.1 1"/>
    <material name="biped_head" rgba="0.95 0.95 0.95 1"/>
    <material name="chassis" rgba="0.15 0.15 0.18 1"/>
    <material name="deck" rgba="0.2 0.6 0.9 1"/>
    <material name="wheel" rgba="0.95 0.8 0.1 1"/>
    <material name="mast" rgba="0.9 0.9 0.9 1"/>
  </asset>

  <default>
    <geom condim="3" friction="1 0.005 0.0001"/>
  </default>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" diffuse="0.6 0.6 0.6" castshadow="true"/>
    <geom name="floor" type="plane" size="2.5 2.5 0.1" material="floor" friction="0.05 0.005 0.0001"/>

    <!-- walls: inner faces at +-2.5 m -->
    <geom name="wall_e" type="box" pos="2.55 0 0.3" size="0.05 2.6 0.3" material="wall_e"/>
    <geom name="wall_w" type="box" pos="-2.55 0 0.3" size="0.05 2.6 0.3" material="wall_w"/>
    <geom name="wall_n" type="box" pos="0 2.55 0.3" size="2.6 0.05 0.3" material="wall_n"/>
    <geom name="wall_s" type="box" pos="0 -2.55 0.3" size="2.6 0.05 0.3" material="wall_s"/>

    <geom name="crate1" type="box" pos="-1.2 1.4 0.15" size="0.2 0.2 0.15" material="crate"/>
    <geom name="crate2" type="box" pos="0.6 -1.5 0.1" size="0.3 0.15 0.1" euler="0 0 25" material="crate"/>
    <geom name="crate3" type="box" pos="-1.5 -1.0 0.2" size="0.15 0.15 0.2" material="crate"/>

    <!-- the biped stand-in: 0.56 m tall -->
    <body name="biped" pos="1.6 1.0 0">
      <geom name="biped_torso" type="box" pos="0 0 0.25" size="0.09 0.14 0.25" material="biped"/>
      <geom name="biped_head" type="box" pos="0 0 0.53" size="0.07 0.07 0.03" material="biped_head"/>
    </body>

    <body name="look" pos="0 0 0.1"/>
    <camera name="overview" pos="-2.2 -2.2 3.4" mode="targetbody" target="look" fovy="65"/>

    <body name="rover" pos="0 0 0.043">
      <freejoint name="root"/>
      <inertial pos="-0.03 0 0" mass="1.2" diaginertia="0.006 0.006 0.010"/>
      <geom name="chassis" type="cylinder" size="0.10 0.012" pos="0 0 0" material="chassis" mass="0.001"/>
      <geom name="deck" type="cylinder" size="0.095 0.005" pos="0 0 0.06" material="deck" mass="0.001" contype="0" conaffinity="0"/>
      <geom name="caster" type="sphere" size="0.012" pos="-0.08 0 -0.031" friction="0.05 0.001 0.0001" mass="0.001"/>
      <geom name="mast_post" type="cylinder" size="0.008" fromto="0.08 0 0.06 0.08 0 0.237" material="mast" mass="0.001" contype="0" conaffinity="0"/>
      <site name="range" pos="0.10 0 0.0" size="0.006"/>

      <body name="wheel_l" pos="0 0.09 -0.01">
        <joint name="wheel_l" type="hinge" axis="0 1 0" damping="0.002" frictionloss="0.02" armature="1e-4"/>
        <geom type="cylinder" size="0.033 0.01" euler="90 0 0" material="wheel" mass="0.05" friction="1.2 0.005 0.0001"/>
      </body>
      <body name="wheel_r" pos="0 -0.09 -0.01">
        <joint name="wheel_r" type="hinge" axis="0 1 0" damping="0.002" frictionloss="0.02" armature="1e-4"/>
        <geom type="cylinder" size="0.033 0.01" euler="90 0 0" material="wheel" mass="0.05" friction="1.2 0.005 0.0001"/>
      </body>

      <!-- pan 90 deg = straight ahead; joint angle = pan - 90, positive = left -->
      <body name="pan" pos="0.08 0 0.237">
        <joint name="pan" type="hinge" axis="0 0 1" range="-90 90" limited="true" damping="0.2"/>
        <inertial pos="0.02 0 0" mass="0.05" diaginertia="1e-4 1e-4 1e-4"/>
        <geom name="head" type="box" size="0.03 0.04 0.02" pos="0.02 0 0" material="mast" mass="0.001" contype="0" conaffinity="0"/>
        <camera name="mast" pos="0.05 0 0" xyaxes="0 -1 0 0 0 1" fovy="60"/>
      </body>
    </body>
  </worldbody>

  <actuator>
    <motor name="act_l" joint="wheel_l" gear="1" ctrlrange="-1 1"/>
    <motor name="act_r" joint="wheel_r" gear="1" ctrlrange="-1 1"/>
    <position name="act_pan" joint="pan" kp="1" ctrlrange="-1.6 1.6"/>
  </actuator>
</mujoco>
